# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Edge Function API Key (if calling directly during dev)
VITE_GROQ_AI_API_KEY=your-ai-api-key

# Licensed Bible translation API (e.g. API.Bible) — required only if
# you're pulling in translations beyond the public-domain set (KJV/WEB/ASV).
VITE_BIBLE_API_KEY=

# App-level config
VITE_APP_NAME=Berea
VITE_APP_ENV=development


