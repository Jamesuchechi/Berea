# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI calls go through the Supabase Edge Function (supabase/functions/ai-assistant).
# The Groq API key is stored as a Supabase secret — NEVER as a VITE_ variable.
# To set the secret on the project:
#   supabase secrets set GROQ_API_KEY=gsk_your_key_here
#
# There is NO client-side AI key. Do not add one.

# Licensed Bible translation API (e.g. API.Bible) — required only if
# you're pulling in translations beyond the public-domain set (KJV/WEB/ASV).
# This is a server-side secret; set via Supabase secrets or a backend env.
# BIBLE_API_KEY=

# App-level config
VITE_APP_NAME=Berea
VITE_APP_ENV=development
